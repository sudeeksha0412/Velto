# Copy this file to .env.local and fill in your own free API keys.
# .env.local is gitignored — never commit your real keys.

# NewsAPI.org — free tier: https://newsapi.org/register
NEWS_API_KEY=your_newsapi_key_here

# TMDB (The Movie Database) — free API key: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here
